FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType laminar;

// OF13: explicit RAS section for compatibility (even if laminar)
RAS
{
    RASModel        laminar;
    turbulence      off;
    printCoeffs     off;
}


